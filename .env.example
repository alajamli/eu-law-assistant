# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/eulaw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eulaw
DB_PORT=55432

# --- LLM ------------------------------------------------------------------
# Groq free tier. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# `local` needs the ML extra: pip install -e ".[ml]"  (~2 GB).
# Use `hashing` for a torch-free demo — but index and query must match.
EMBEDDING_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
RETRIEVE_TOP_K=30
RERANK_TOP_N=5

# --- App ------------------------------------------------------------------
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20

# --- Observability --------------------------------------------------------
# Leave empty to disable tracing locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
